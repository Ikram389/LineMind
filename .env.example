# Copy this file to .env and change the values. Never commit .env.

# PostgreSQL (used by both the db container and Django)
POSTGRES_DB=linemind
POSTGRES_USER=linemind
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Password given to every demo user created by `python manage.py seed_demo` (development only)
DEMO_USER_PASSWORD=change-me-demo-password

# Line API key the simulator uses to send events (create one with
# `docker compose exec backend python manage.py create_line_api_key <line_id> "Simulator"`)
SIMULATOR_API_KEY=

# Port on your Windows machine where the backend is exposed (change if 8000 is taken)
BACKEND_PORT=8000

# Alerts by email. In development the mailpit service catches every message (http://localhost:8025),
# so no real mail server is needed. For a real server set EMAIL_HOST/PORT/USER/PASSWORD/USE_TLS.
DEFAULT_FROM_EMAIL=LineMind <alerts@linemind.local>
# Links in alert emails point here
FRONTEND_URL=http://localhost:5173
